# Holistic — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env.

# SQLite database for local development (portable to PostgreSQL in deployment).
DATABASE_URL="file:./db/holistic.db"

# Session signing secret. REQUIRED in production — the app fails fast without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# CORS origins allowed by the API (comma-separated). Leave empty for same-origin only.
CORS_ORIGINS=

# Optional: Google OAuth (feature disabled unless configured; email/password is independent).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Weather provider: Open-Meteo requires NO API key by default. If you switch to a
# keyed provider, put the key here and keep it server-side only.
WEATHER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Android companion app download URL (signed APK or its download page).
# Rendered as the QR code + Download button in the Health Data section.
# Left empty, the page shows setup instructions instead of a placeholder QR.
NEXT_PUBLIC_COMPANION_APK_URL=
